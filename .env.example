# Public Firebase web application configuration. Never put private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=
# Demo is opt-in. Production mode fails closed when configuration is missing.
VITE_DEMO_MODE=false
# Explicit frontend-only publication: real site, with reservations unavailable.
VITE_FRONTEND_ONLY=true
